---
// A table of an entity's values (src/lib/values.mjs): an array's elements, a group of fields, or a table a loader
// built. Every cell holds values as `Value` draws them, several joined by commas. A column whose cells are all numbers
// aligns them on the right, so they compare down the column. The row labels take a column of their own, and the header
// is left out when no column has a label (an array in the infobox, whose row already names it). A row's label may be a
// text of the game (a stage's objective), in each language it has; a column's label may have a note. A column whose
// cells list items that each name themselves ("Max HP +5", a link) stacks them one to a line. A table wider than its
// box keeps its first column in place while the rest scrolls, and its second too where the first holds record numbers
// (src/styles/site.css). A name may have its entity's picture beside it (a "Related" table), which takes `data`. A
// column of a kind's list (lib/columns.mjs) has its group's label over its own, which may be the game's name for it in
// each language (an element). A column that lists entries (a recipe's ingredients) wraps, as a list's does.
import Label from './Label.astro';
import Name from './Name.astro';
import Value from './Value.astro';

type Item = {
	text?: string;
	entity?: { url: string; title: string; names: Record<string, string> };
	missing?: string;
	title?: string;
	names?: Record<string, string>;
	thumb?: { file: string; explicit: boolean; width: number; height: number } | null;
};

interface Props {
	columns: {
		label: string | { title: string; names: Record<string, string> } | null;
		group?: string | null;
		note?: string | null;
		stack?: boolean;
		wrap?: boolean;
	}[];
	rows: { label?: string | number | Item | null; cells: Item[][] }[];
	/** The heading of the row labels' column, when the rows have labels. */
	rowHeader?: string;
	/** `nested` sits in a row of the infobox; `wide` is a page's own table, which scrolls in its box. */
	variant: 'nested' | 'wide';
	/** The export, where a cell shows an entity's picture. */
	data?: { game: string; revision: string };
}

const { columns, rows, rowHeader = '', variant, data } = Astro.props;
const labelled = rows.some((row) => row.label !== null && row.label !== undefined);
const numbered = labelled && columns.length > 0 && rows.every((row) => typeof row.label === 'number');
const header = columns.some((column) => column.label);
const NUMBER = /^([-+]?\d[\d,]*(\.\d+)?(%| [a-z]+)?|—)$/;
const numeric = columns.map(
	(_, c) =>
		rows.some((row) => row.cells[c].length > 0) &&
		rows.every((row) => row.cells[c].every((item) => item.text !== undefined && NUMBER.test(item.text))),
);
---

<table class:list={['ome-table', `ome-${variant}`, { 'ome-numbered': numbered }]}>
	{
		header && (
			<thead>
				<tr>
					{labelled && <th scope="col">{rowHeader}</th>}
					{columns.map((column, c) => (
						<th scope="col" class:list={{ 'ome-num': numeric[c] }}>
							{column.group && <span class="ome-col-group">{column.group}</span>}
							{column.label && typeof column.label === 'object' ? (
								<Name entity={column.label} />
							) : (
								<Label text={column.label} note={column.note} />
							)}
						</th>
					))}
				</tr>
			</thead>
		)
	}
	<tbody>
		{
			rows.map((row) => (
				<tr>
					{labelled && <th scope="row">{typeof row.label === 'object' && row.label ? <Value item={row.label} data={data} /> : row.label}</th>}
					{row.cells.map((items, c) => (
						<td class:list={{ 'ome-num': numeric[c], 'ome-wrap': columns[c].wrap }}>
							{items.map((item, i) => (
								<>
									{i > 0 && (columns[c].stack ? <br /> : ', ')}
									<Value item={item} data={data} />
								</>
							))}
						</td>
					))}
				</tr>
			))
		}
	</tbody>
</table>
