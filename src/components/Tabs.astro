---
// Tabs over panels (site plan §9): a tab for each panel, its count beside its name, and one panel shown at a time
// (an entity's "Related" tables; the search's results page builds its own the same way, §9.2). The panels are the
// slot's elements, in the tabs' order, each with the id its tab names and a heading with the `ome-tab-heading` class.
// Without scripts the tabs stay hidden and every panel shows under its heading. How a tab is chosen:
// src/scripts/tabs.ts.
interface Props {
	/** What the tabs choose between, for screen readers. */
	label: string;
	tabs: { id: string; label: string; count?: number }[];
}

const { label, tabs } = Astro.props;
---

<div class="ome-tabs" data-ome-tabs>
	<div class="ome-tablist not-content" role="tablist" aria-label={label} hidden>
		{
			tabs.map((tab, i) => (
				<button
					type="button"
					role="tab"
					id={`${tab.id}-tab`}
					aria-controls={tab.id}
					aria-selected={i === 0 ? 'true' : 'false'}
					tabindex={i === 0 ? 0 : -1}
				>
					{tab.label}
					{tab.count !== undefined && <span class="ome-tab-count">{tab.count.toLocaleString('en')}</span>}
				</button>
			))
		}
	</div>
	<slot />
</div>

<script>
	import { tabs } from '../scripts/tabs.ts';

	for (const box of document.querySelectorAll<HTMLElement>('[data-ome-tabs]')) tabs(box);
</script>
