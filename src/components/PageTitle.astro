---
// Starlight's page title. An entity page whose name the export translates gives its names (Astro.locals.omeNames,
// set by the page), and the title shows the name in the chosen language with the others beside it (site design §8.6),
// one form for each language, which the language switch picks (DatabaseSwitches.astro). The search index takes the
// names once each: the names beside are left out of it.
import Default from '@astrojs/starlight/components/PageTitle.astro';

// Starlight's PAGE_TITLE_ID, which its package does not export: the table of contents links to it.
const PAGE_TITLE_ID = '_top';
const names = Object.entries(Astro.locals.omeNames ?? {});
---

{
	names.length > 1 ? (
		<h1 id={PAGE_TITLE_ID}>
			{names.map(([tag, name], i) => (
				<span data-ome-text={tag}>
					{i > 0 && ' '}
					<span lang={tag}>{name}</span>
					{names
						.filter(([other]) => other !== tag)
						.map(([other, otherName]) => (
							<>
								{' '}
								<small class="ome-other-name" lang={other} data-pagefind-ignore>
									{otherName}
								</small>
							</>
						))}
				</span>
			))}
		</h1>
	) : (
		<Default />
	)
}

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}
	.ome-other-name {
		font-size: 0.55em;
		font-weight: 400;
		color: var(--sl-color-gray-3);
	}
</style>
