---
// An entity's name (site design §8.6): in each language it has one, and the language switch (DatabaseSwitches.astro)
// shows one of them; a name the export does not translate shows as the game has it.
import { SOURCE_LANGUAGE } from '../lib/language.mjs';

interface Props {
	entity: { title: string; names: Record<string, string> };
}

const { entity } = Astro.props;
const names = Object.entries(entity.names);
---

{
	names.length > 1 ? (
		names.map(([tag, name], i) => (
			<>
				{i > 0 && ' '}
				<span lang={tag} data-ome-text={tag}>{name}</span>
			</>
		))
	) : names.length === 1 ? (
		<span lang={SOURCE_LANGUAGE}>{entity.title}</span>
	) : (
		entity.title
	)
}
