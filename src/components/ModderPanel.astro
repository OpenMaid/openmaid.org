---
// The modder panel of an entity page (site design §8.7, OME's export design §6.6): hidden unless modder mode is on. It
// names the record as OMS and data files do, lists every cell a script wrote, with its value, its writer (so its layer)
// and its address, then the cells of the tables the game's loaders build for it (a stage's enemies), and gives a data
// file that sets what the page shows. A string field the kind does not publish shows no value. The scripts that use
// the table are listed once, on the kind's page.
interface Field { name: string; isArray: boolean; width: number | null; columns: (string | null)[] | null }
interface Cell { field: string; idx: number; bank: string; address: number; raw: string | null; writer: string | null }
interface Props {
	game: string;
	kind: {
		id: string;
		table: string;
		label: { one: string; many: string };
		fields: Field[];
		loaded: { name: string; table: string; scope: string; label: { one: string; many: string }; fields: Field[] }[];
		scriptUse: unknown[];
	};
	entity: { id: number; cells: Cell[]; pictures: { name: string; file: string }[]; snippet: string | null };
}
const { game, kind, entity } = Astro.props;
const fields = new Map(kind.fields.map((field) => [field.name, field]));
const key = (field: string, idx: number) => {
	const f = fields.get(field);
	return f?.isArray ? `${field}.${f.columns?.[idx] ?? idx}` : field;
};
const hex = (n: number) => `0x${n.toString(16)}`;
const pictures = [...new Map(entity.pictures.map((p) => [p.file, p])).values()];

// A loaded table's cell is written <table>.<field>, its index the record times the field's width plus the element
// (OME's export plan §4.3).
const loadedFields = new Map(
	kind.loaded.flatMap((table) => table.fields.map((field, order) => [`${table.name}.${field.name}`, { table, field, order }])),
);
const own = entity.cells.filter((cell) => !loadedFields.has(cell.field));
const loaded = kind.loaded
	.map((table) => ({
		table,
		cells: entity.cells
			.filter((cell) => loadedFields.get(cell.field)?.table === table)
			.map((cell) => {
				const { field, order } = loadedFields.get(cell.field)!;
				const width = field.isArray ? (field.width ?? 1) : 1;
				const element = cell.idx % width;
				return {
					...cell,
					order,
					element,
					record: Math.floor(cell.idx / width),
					name: field.isArray ? `${field.name}.${field.columns?.[element] ?? element}` : field.name,
				};
			})
			.sort((a, b) => a.record - b.record || a.order - b.order || a.element - b.element),
	}))
	.filter((t) => t.cells.length > 0);
---

<section class="ome-modder" aria-labelledby="modder-data" data-pagefind-ignore>
	<h2 id="modder-data">Modder data</h2>
	<p>
		Record {entity.id} of the table <code>{kind.table}</code>: <code>{kind.table}[{entity.id}]</code> in OMS and Lua,
		<code>[{kind.table}.{entity.id}]</code> in a data file. Each cell below is one a script wrote; a cell no script
		wrote holds its default.
	</p>
	<table class="ome-cells">
		<thead><tr><th>Field</th><th>Value</th><th>Written by</th><th>Cell</th></tr></thead>
		<tbody>
			{
				own.map((cell) => (
					<tr>
						<td><code>{key(cell.field, cell.idx)}</code></td>
						<td>{cell.raw ?? <em>not published</em>}</td>
						<td>{cell.writer ?? '—'}</td>
						<td><code>{cell.bank}:{hex(cell.address)}</code></td>
					</tr>
				))
			}
		</tbody>
	</table>
	{
		loaded.map(({ table, cells }) => (
			<>
				<h3>Cells of its {table.label.many.toLowerCase()}</h3>
				<p>
					The table <code>{table.table}</code>, which the game builds when it loads this {kind.label.one.toLowerCase()}:
					its record <var>r</var> is <code>[{table.scope}.{entity.id}.{table.name}.<var>r</var>]</code> in a data file.
				</p>
				<table class="ome-cells">
					<thead><tr><th>Record</th><th>Field</th><th>Value</th><th>Written by</th><th>Cell</th></tr></thead>
					<tbody>
						{cells.map((cell) => (
							<tr>
								<td>{cell.record}</td>
								<td><code>{cell.name}</code></td>
								<td>{cell.raw ?? <em>not published</em>}</td>
								<td>{cell.writer ?? '—'}</td>
								<td><code>{cell.bank}:{hex(cell.address)}</code></td>
							</tr>
						))}
					</tbody>
				</table>
			</>
		))
	}
	{
		pictures.length > 0 && (
			<p>
				Pictures by catalog name:{' '}
				{pictures.map((p, i) => (
					<>
						{i > 0 && ', '}
						<code>{p.file.replace(/\.png$/, '')}</code>
					</>
				))}
				.
			</p>
		)
	}
	{
		kind.scriptUse.length > 0 && (
			<p>
				{kind.scriptUse.length} scripts read, write or index the table <code>{kind.table}</code>
				{kind.loaded.length > 0 && ' or the tables its loaders build'}:{' '}
				<a href={`/${game}/${kind.id}/#scripts`}>the list is on the {kind.label.many.toLowerCase()} page</a>.
			</p>
		)
	}
	{
		entity.snippet && (
			<>
				<h3>A data file for this {kind.label.one.toLowerCase()}</h3>
				<p>
					It sets each value this page shows to the value it has now, in the names the game's base mod gives them. Copy
					it into a mod's data file and change what you need (<a href="/docs/data-files/">data files</a>).
				</p>
				<pre><code>{entity.snippet}</code></pre>
			</>
		)
	}
</section>
