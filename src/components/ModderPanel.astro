---
// The modder panel of an entity page (site design §8.7, OME's export design §6.6): hidden unless modder mode is on. It
// names the record as OMS and data files do, lists every cell a script wrote, with its value, its writer (so its layer)
// and its address, then the cells of the tables the game's loaders build for it (a stage's enemies), and gives a data
// file that sets what the page shows. A string field the kind does not publish shows no value. The scripts that use
// the table are listed once, on the kind's page; the calls that name this entity, each at its offset (OME's export
// §6.7), are listed here. Each table, field and script name links to its reference page (§8.7). A run of an array's
// cells that one script wrote alike is one row (site plan §10), so every cell is still listed: a unit's title changes
// write 1,000 skill flags each, most of them 0, which were 11,000 rows on one page.
interface Field { name: string; isArray: boolean; width: number | null; columns: (string | null)[] | null }
interface Cell { field: string; idx: number; bank: string; address: number; raw: string | null; writer: string | null }
interface Props {
	game: string;
	kind: {
		id: string;
		table: string;
		label: { one: string; many: string };
		fields: Field[];
		loaded: { name: string; table: string; scope: string | null; label: { one: string; many: string }; fields: Field[] }[];
		scriptUse: unknown[];
	};
	entity: {
		id: number;
		cells: Cell[];
		pictures: { name: string; file: string }[];
		snippet: string | null;
		relations: { relation: string; script: string; offset: number; count: number | null }[];
	};
}
import { referenceGame } from '../lib/reference.mjs';
import { href } from '../lib/reference-model.mjs';

const { game, kind, entity } = Astro.props;
const reference = referenceGame(game);
const tableLink = (name: string) => (reference.table(name) ? href.table(game, name) : null);
const globalOf = (table: string, field: string) => reference.table(table)?.fields.find((f) => f.name === field)?.global ?? null;
const scriptLink = (name: string | null) => (name && reference.script(name) ? href.script(game, name) : null);
const fields = new Map(kind.fields.map((field) => [field.name, field]));
const key = (field: string, idx: number) => {
	const f = fields.get(field);
	return f?.isArray ? `${field}.${f.columns?.[idx] ?? idx}` : field;
};
const hex = (n: number) => `0x${n.toString(16)}`;
const pictures = [...new Map(entity.pictures.map((p) => [p.file, p])).values()];

// Cells in rows: a cell joins the row before it when both are elements without a column name of one field (in one
// record), the next element at the next cell, with the same value and writer. A named column or a single value stands
// alone.
interface Shown { name: string; element: number | null; group: string }
interface Row<C> { cell: C; first: string; last: string | null; lastElement: number | null; lastAddress: number; count: number; group: string }
function rows<C extends Cell>(cells: C[], shown: (cell: C) => Shown): Row<C>[] {
	const out: Row<C>[] = [];
	for (const cell of cells) {
		const s = shown(cell);
		const prev = out.at(-1);
		if (
			prev &&
			s.element !== null &&
			prev.lastElement !== null &&
			prev.group === s.group &&
			s.element === prev.lastElement + 1 &&
			cell.address === prev.lastAddress + 1 &&
			cell.bank === prev.cell.bank &&
			cell.raw === prev.cell.raw &&
			cell.writer === prev.cell.writer
		) {
			prev.last = s.name;
			prev.lastElement = s.element;
			prev.lastAddress = cell.address;
			prev.count++;
		} else {
			out.push({ cell, first: s.name, last: null, lastElement: s.element, lastAddress: cell.address, count: 1, group: s.group });
		}
	}
	return out;
}
// A loaded table's cell is written <table>.<field>, its index the record times the field's width plus the element
// (OME's export plan §4.3).
const byField = new Map(
	kind.loaded.flatMap((table) => table.fields.map((field, order) => [`${table.name}.${field.name}`, { table, field, order }])),
);
const own = rows(entity.cells.filter((cell) => !byField.has(cell.field)), (cell) => {
	const f = fields.get(cell.field);
	const unnamed = f?.isArray && f.columns?.[cell.idx] == null;
	return { name: key(cell.field, cell.idx), element: unnamed ? cell.idx : null, group: cell.field };
});
const loaded = kind.loaded
	.map((table) => ({
		table,
		cells: entity.cells
			.filter((cell) => byField.get(cell.field)?.table === table)
			.map((cell) => {
				const { field, order } = byField.get(cell.field)!;
				const width = field.isArray ? (field.width ?? 1) : 1;
				const element = cell.idx % width;
				return {
					...cell,
					order,
					element,
					unnamed: field.isArray && field.columns?.[element] == null,
					record: Math.floor(cell.idx / width),
					name: field.isArray ? `${field.name}.${field.columns?.[element] ?? element}` : field.name,
				};
			})
			.sort((a, b) => a.record - b.record || a.order - b.order || a.element - b.element),
	}))
	.filter((t) => t.cells.length > 0)
	.map(({ table, cells }) => ({
		table,
		cells: rows(cells, (cell) => ({ name: cell.name, element: cell.unnamed ? cell.element : null, group: `${cell.record}.${cell.field}` })),
	}));
---

<section class="ome-modder" aria-labelledby="modder-data" data-pagefind-ignore>
	<h2 id="modder-data">Modder data</h2>
	<p>
		Record {entity.id} of the table <a href={tableLink(kind.table)}><code>{kind.table}</code></a>: <code>{kind.table}[{entity.id}]</code> in OMS and Lua,
		<code>[{kind.table}.{entity.id}]</code> in a data file. Each cell below is one a script wrote; a cell no script
		wrote holds its default. A run of an array's cells that one script wrote alike is one row.
	</p>
	<table class="ome-cells">
		<thead><tr><th>Field</th><th>Value</th><th>Written by</th><th>Cell</th></tr></thead>
		<tbody>
			{
				own.map(({ cell, first, last, lastAddress, count }) => (
					<tr>
						<td>
							{globalOf(kind.table, cell.field) ? <a href={href.global(game, globalOf(kind.table, cell.field)!)}><code>{first}</code></a> : <code>{first}</code>}
							{last && <> to <code>{last}</code> ({count} cells)</>}
						</td>
						<td>{cell.raw ?? <em>not published</em>}</td>
						<td>{scriptLink(cell.writer) ? <a href={scriptLink(cell.writer)}>{cell.writer}</a> : (cell.writer ?? '—')}</td>
						<td><code>{cell.bank}:{hex(cell.address)}</code>{last && <> to <code>{hex(lastAddress)}</code></>}</td>
					</tr>
				))
			}
		</tbody>
	</table>
	{
		loaded.map(({ table, cells }) => (
			<>
				<h3>Cells of its {table.label.many.toLowerCase()}</h3>
				{table.scope ? (
					<p>
						The table <a href={tableLink(table.table)}><code>{table.table}</code></a>, which the game builds when it loads this {kind.label.one.toLowerCase()}:
						its record <var>r</var> is <code>[{table.scope}.{entity.id}.{table.name}.<var>r</var>]</code> in a data file.
					</p>
				) : (
					<p>
						The table <a href={tableLink(table.table)}><code>{table.table}</code></a>, which the game's scripts fill again for each
						row of this {kind.label.one.toLowerCase()}'s {table.label.many.toLowerCase()}, numbered here as on the page. A data
						file does not edit it.
					</p>
				)}
				<table class="ome-cells">
					<thead><tr><th>Record</th><th>Field</th><th>Value</th><th>Written by</th><th>Cell</th></tr></thead>
					<tbody>
						{cells.map(({ cell, first, last, lastAddress, count }) => (
							<tr>
								<td>{cell.record}</td>
								<td>
									{globalOf(table.table, cell.field.slice(table.name.length + 1)) ? <a href={href.global(game, globalOf(table.table, cell.field.slice(table.name.length + 1))!)}><code>{first}</code></a> : <code>{first}</code>}
									{last && <> to <code>{last}</code> ({count} cells)</>}
								</td>
								<td>{cell.raw ?? <em>not published</em>}</td>
								<td>{scriptLink(cell.writer) ? <a href={scriptLink(cell.writer)}>{cell.writer}</a> : (cell.writer ?? '—')}</td>
								<td><code>{cell.bank}:{hex(cell.address)}</code>{last && <> to <code>{hex(lastAddress)}</code></>}</td>
							</tr>
						))}
					</tbody>
				</table>
			</>
		))
	}
	{
		pictures.length > 0 && (
			<p>
				Pictures by catalog name:{' '}
				{pictures.map((p, i) => (
					<>
						{i > 0 && ', '}
						<code>{p.file.replace(/\.png$/, '')}</code>
					</>
				))}
				.
			</p>
		)
	}
	{
		kind.scriptUse.length > 0 && (
			<p>
				{kind.scriptUse.length} scripts read, write or index the table <a href={tableLink(kind.table)}><code>{kind.table}</code></a>
				{kind.loaded.length > 0 && ' or the tables its loaders build'}:{' '}
				<a href={`/${game}/${kind.id}/#scripts`}>the list is on the {kind.label.many.toLowerCase()} page</a>.
			</p>
		)
	}
	{
		entity.relations.length > 0 && (
			<>
				<h3>The calls that name it</h3>
				<p>
					Each call a script makes with this {kind.label.one.toLowerCase()} in its arguments, at the call's offset in the
					script, with the count as the script sets it.
				</p>
				<table class="ome-cells">
					<thead><tr><th>Relation</th><th>At</th><th>Count</th></tr></thead>
					<tbody>
						{entity.relations.map((r) => (
							<tr>
								<td><code>{r.relation}</code></td>
								<td>
									{scriptLink(r.script) ? <a href={scriptLink(r.script)}><code>{r.script}</code></a> : <code>{r.script}</code>}
									<code>@{hex(r.offset)}</code>
								</td>
								<td>{r.count ?? '—'}</td>
							</tr>
						))}
					</tbody>
				</table>
			</>
		)
	}
	{
		entity.snippet && (
			<>
				<h3>A data file for this {kind.label.one.toLowerCase()}</h3>
				<p>
					It sets each value this page shows to the value it has now, in the names the game's base mod gives them. Copy
					it into a mod's data file and change what you need (<a href="/docs/data-files/">data files</a>).
				</p>
				<pre class="ome-snippet"><code>{entity.snippet}</code></pre>
			</>
		)
	}
</section>
