---
// The database's switches, remembered in the browser (site design §8.6, §8.7, §8.11): modder mode shows each page's
// modder panel, "explicit pictures" shows them without the blur, and the game text's language picks which of an
// element's languages shows (Name.astro), when the export translates the text. The head script (astro.config.mjs)
// restores them before the first paint as attributes on <html>, which the styles read; with none chosen, game text
// shows in the first language the export translates it into.
import { SOURCE_LANGUAGE } from '../lib/export.mjs';
import { languageName } from '../lib/labels.mjs';

interface Props {
	/** The languages the export translates the game text into. */
	languages?: string[];
}

const { languages = [] } = Astro.props;
---

<div class="ome-switches not-content" data-pagefind-ignore>
	<label><input type="checkbox" data-ome-switch="ome-modder-mode" data-attribute="data-ome-modder" /> Modder mode</label>
	<label><input type="checkbox" data-ome-switch="ome-show-explicit" data-attribute="data-ome-explicit" /> Show explicit pictures</label>
	{
		languages.length > 0 && (
			<label>
				Game text{' '}
				<select data-ome-language>
					{[...languages, SOURCE_LANGUAGE].map((tag) => (
						<option value={tag} lang={tag}>{languageName(tag)}</option>
					))}
				</select>
			</label>
		)
	}
</div>

<script>
	for (const input of document.querySelectorAll<HTMLInputElement>('input[data-ome-switch]')) {
		const attribute = input.dataset.attribute!;
		input.checked = document.documentElement.hasAttribute(attribute);
		input.addEventListener('change', () => {
			document.documentElement.toggleAttribute(attribute, input.checked);
			try {
				if (input.checked) localStorage.setItem(input.dataset.omeSwitch!, '1');
				else localStorage.removeItem(input.dataset.omeSwitch!);
			} catch {}
		});
	}
	for (const select of document.querySelectorAll<HTMLSelectElement>('select[data-ome-language]')) {
		const chosen = document.documentElement.getAttribute('data-ome-lang');
		if (chosen && [...select.options].some((option) => option.value === chosen)) select.value = chosen;
		select.addEventListener('change', () => {
			document.documentElement.setAttribute('data-ome-lang', select.value);
			try {
				localStorage.setItem('ome-game-language', select.value);
			} catch {}
		});
	}
</script>
