---
// An entity page (site design §8.2): its name, pictures and kind; an infobox of its published fields; its text; the
// tables the game's loaders build for it (a stage's enemies and its allies); what refers to it, each list under the
// heading the export gives it ("Dropped by") and, where it names details, as a table of them; the modder panel, which
// also lists the calls of the game's scripts that name it; and, at its foot, the game data revision it is from and the
// credit of the translation it shows. Its names and text are in each language the export translates them into, the
// switch showing one (§8.6), the tab's title and the pictures' text too (site plan §10.3). Search indexes its name and
// text only, with the game and kind as filters (§8.4).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ome from 'virtual:ome';
import DatabaseSwitches from '../../../../components/DatabaseSwitches.astro';
import LanguageCredit from '../../../../components/LanguageCredit.astro';
import DataTable from '../../../../components/DataTable.astro';
import Label from '../../../../components/Label.astro';
import ModderPanel from '../../../../components/ModderPanel.astro';
import Picture from '../../../../components/Picture.astro';
import Tabs from '../../../../components/Tabs.astro';
import Value from '../../../../components/Value.astro';
import WidePage from '../../../../components/WidePage.astro';
import { databaseSidebar, game, games, pictureUrl } from '../../../../lib/database.mjs';
import { label } from '../../../../lib/labels.mjs';
import { SOURCE_LANGUAGE } from '../../../../lib/language.mjs';
import { infobox, loadedTables, referencedBy, texts, translated } from '../../../../lib/values.mjs';

export function getStaticPaths() {
	return games().flatMap((data) =>
		data.kinds.flatMap((kind) =>
			kind.entities.map((entity) => ({
				params: { game: data.game, kind: kind.id, id: String(entity.id), slug: entity.slug },
				props: { kindId: kind.id, id: entity.id },
			})),
		),
	);
}

const data = game(Astro.params.game!);
const kind = data.kinds.find((k) => k.id === Astro.props.kindId)!;
const entity = data.byKey.get(`${kind.id}:${Astro.props.id}`)!;
const rows = infobox(kind, entity);
const text = texts(kind, entity);
const incoming = referencedBy(data, entity);
const loaded = loadedTables(kind, entity);
// The title holds the name in each language it has (src/components/PageTitle.astro), and the page credits the
// translations it shows: the entity's, and the names of those it links to.
if (Object.keys(entity.names).length > 1) Astro.locals.omeNames = entity.names;
const credited = translated([
	entity,
	...entity.refs.map((ref: { target: unknown }) => ref.target).filter(Boolean),
	...entity.referencedBy.map((by: { from: unknown }) => by.from),
]);
// One picture shown once, under every name it has (a unit's battle_1 and battle_2 are often the same file).
const pictures = [...Map.groupBy(entity.pictures, (p: { file: string }) => p.file).values()].map((same) => ({
	...same[0],
	names: same.map((p: { name: string }) => label(p.name)).join(', '),
}));

// A section with nothing in it has no heading (site plan §13, B2): an entity whose fields are all none has no details.
const headings = [
	...(rows.length ? [{ depth: 2, slug: 'details', text: 'Details' }] : []),
	...(text.length ? [{ depth: 2, slug: 'text', text: 'Text' }] : []),
	...loaded.map((t) => ({ depth: 2, slug: t.id, text: t.label })),
	...(incoming.length ? [{ depth: 2, slug: 'related', text: 'Related' }] : []),
];
const version = data.manifest.game_version ? `, game version ${data.manifest.game_version}` : '';
// The tab's title in each language the name is in: that language's name first, the others after it, and the database.
// The page's own is the language a page shows first; the language switch sets the chosen one's (DatabaseSwitches).
const shownFirst = data.languages.find((tag: string) => entity.names[tag]) ?? SOURCE_LANGUAGE;
const names: [string, string][] = Object.entries(entity.names);
const titleIn = (tag: string) => {
	const others = [...new Set(names.filter(([t, name]) => t !== tag && name !== entity.names[tag]).map(([, name]) => name))];
	return `${entity.names[tag]}${others.length ? ` (${others.join(', ')})` : ''} – ${data.title} database | ${ome.title}`;
};
const titles = names.length > 1 ? Object.fromEntries(names.map(([tag]) => [tag, titleIn(tag)])) : null;
const pageTitle = titles ? titles[shownFirst] : `${entity.title} – ${data.title} database | ${ome.title}`;
// A picture's text names the entity in each language its name is in.
const altOf = (caption: string) =>
	names.length > 0 ? Object.fromEntries(names.map(([tag, name]) => [tag, `${name}: ${caption}`])) : `${entity.title}: ${caption}`;
---

<StarlightPage
	frontmatter={{
		title: entity.title,
		// The tab and a search engine's result name the database the page is in.
		head: [
			{ tag: 'title', content: pageTitle },
			{ tag: 'meta', attrs: { property: 'og:title', content: pageTitle } },
			...(titles ? [{ tag: 'meta' as const, attrs: { name: 'ome-titles', content: JSON.stringify(titles) } }] : []),
		],
		// No contents rail: its room goes to the tables, and the sections are a line of links (site plan §13, C1).
		tableOfContents: false,
		prev: false,
		next: false,
	}}
	sidebar={databaseSidebar(data, kind.id)}
	headings={headings}
>
	<span data-pagefind-filter={`game:${data.title}`}></span>
	<span data-pagefind-filter={`kind:${kind.label.one}`}></span>
	<p class="ome-entity-line" data-pagefind-ignore>
		<a href={`/${data.game}/${kind.id}/`}>{kind.label.one}</a> {entity.id} of {data.title}
	</p>
	<DatabaseSwitches languages={data.languages} />
	{
		headings.length > 1 && (
			<nav class="ome-sections" aria-label="On this page" data-pagefind-ignore>
				<span>On this page:</span>
				{headings.map((heading) => (
					<a href={`#${heading.slug}`}>{heading.text}</a>
				))}
				<a href="#modder-data" class="ome-modder-link">Modder data</a>
			</nav>
		)
	}

	{
		pictures.length > 0 && (
			<div class="ome-pictures not-content" data-pagefind-ignore>
				{pictures.map((picture) => (
					<figure>
						{picture.explicit ? (
							<Picture data={data} picture={picture} alt={altOf(picture.names)} lang={shownFirst} />
						) : (
							<a href={pictureUrl(data, picture)}>
								<Picture data={data} picture={picture} alt={altOf(picture.names)} lang={shownFirst} />
							</a>
						)}
						<figcaption>{picture.names}</figcaption>
					</figure>
				))}
			</div>
		)
	}

	{
		rows.length > 0 && (
			<>
				<h2 id="details" data-pagefind-ignore>Details</h2>
				<table class="ome-infobox" data-pagefind-ignore>
					<tbody>
						{rows.map((row) => (
							<tr>
								<th scope="row"><Label text={row.label} note={row.note} /></th>
								<td>
									{row.table ? (
										<DataTable variant="nested" columns={row.table.columns} rows={row.table.rows} />
									) : (
										row.items.map((item, i) => (
											<>
												{i > 0 && ', '}
												<Value item={item} data={data} />
											</>
										))
									)}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</>
		)
	}

	{
		text.length > 0 && (
			<>
				<h2 id="text" data-pagefind-ignore>Text</h2>
				<table class="ome-infobox ome-text">
					<tbody>
						{text.map((t) => (
							<tr>
								<th scope="row" data-pagefind-ignore><Label text={t.label} note={t.note} /></th>
								<td>
									{t.languages.map(([tag, lines]) => (
										<div lang={tag} data-ome-text={t.translated ? tag : undefined}>
											{lines.map((line, i) => (
												<>
													{i > 0 && <br />}
													{line}
												</>
											))}
										</div>
									))}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</>
		)
	}

	{
		loaded.map((t) => (
			<div data-pagefind-ignore>
				<h2 id={t.id}>{t.label}</h2>
				{t.note && <p>{t.note}</p>}
				<DataTable variant="wide" columns={t.columns} rows={t.rows} rowHeader="#" />
			</div>
		))
	}

	{
		incoming.length > 0 && (
			<div data-pagefind-ignore>
				<h2 id="related">Related</h2>
				<Tabs label="Related entries" tabs={incoming.map((group) => ({ id: group.id, label: group.label, count: group.count }))}>
					{incoming.map((group) => (
						<section id={group.id}>
							<h3 class="ome-tab-heading">{group.label}</h3>
							<DataTable variant="wide" data={data} columns={group.table.columns} rows={group.table.rows} />
						</section>
					))}
				</Tabs>
			</div>
		)
	}

	<ModderPanel game={data.game} kind={kind} entity={entity} />
	<p class="ome-entity-line ome-page-foot" data-pagefind-ignore>
		From {data.title}'s game data revision <code>{data.revision}</code>{version}.
	</p>
	{credited && <LanguageCredit data={data} switched />}
	<script is:inline src="/tooltips.js" defer></script>
	<WidePage />
</StarlightPage>
