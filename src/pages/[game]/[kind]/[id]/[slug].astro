---
// An entity page (site design §8.2): its name, pictures, kind and game revision; an infobox of its published fields;
// its text; the tables the game's loaders build for it (a stage's enemies); what refers to it; what the game's scripts
// do with it; and the modder panel. Its names and text are in each language the export translates them into, the
// switch showing one (§8.6). Search indexes its name and text only, with the game and kind as filters (§8.4).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DatabaseSwitches from '../../../../components/DatabaseSwitches.astro';
import LanguageCredit from '../../../../components/LanguageCredit.astro';
import DataTable from '../../../../components/DataTable.astro';
import ModderPanel from '../../../../components/ModderPanel.astro';
import Name from '../../../../components/Name.astro';
import Picture from '../../../../components/Picture.astro';
import Value from '../../../../components/Value.astro';
import { databaseSidebar, game, games } from '../../../../lib/database.mjs';
import { label } from '../../../../lib/labels.mjs';
import { referenceGame } from '../../../../lib/reference.mjs';
import { href, scriptName } from '../../../../lib/reference-model.mjs';
import { SOURCE_LANGUAGE } from '../../../../lib/export.mjs';
import { infobox, loadedTables, referencedBy, scriptRelations, texts, translated } from '../../../../lib/values.mjs';

export function getStaticPaths() {
	return games().flatMap((data) =>
		data.kinds.flatMap((kind) =>
			kind.entities.map((entity) => ({
				params: { game: data.game, kind: kind.id, id: String(entity.id), slug: entity.slug },
				props: { kindId: kind.id, id: entity.id },
			})),
		),
	);
}

const data = game(Astro.params.game!);
const kind = data.kinds.find((k) => k.id === Astro.props.kindId)!;
const entity = data.byKey.get(`${kind.id}:${Astro.props.id}`)!;
const rows = infobox(kind, entity);
const text = texts(kind, entity);
const incoming = referencedBy(data, entity);
const loaded = loadedTables(kind, entity);
const relations = scriptRelations(entity);
// The title holds the name in each language it has (src/components/PageTitle.astro), and the page credits the
// translations it shows: the entity's, and the names of those it links to.
if (Object.keys(entity.names).length > 1) Astro.locals.omeNames = entity.names;
const credited = translated([
	entity,
	...entity.refs.map((ref: { target: unknown }) => ref.target).filter(Boolean),
	...entity.referencedBy.map((by: { from: unknown }) => by.from),
]);
const reference = referenceGame(data.game);
const scriptLink = (key: string) => (reference.script(key) ? href.script(data.game, key) : null);
// A script's calls in a line: the counts they set, or how many calls when the relation has no count.
const calls = (list: { count: number | null }[]) =>
	list.every((call) => call.count === null)
		? list.length > 1 ? ` (${list.length} calls)` : ''
		: ` (${list.map((call) => call.count ?? '?').join(', ')})`;

// One picture shown once, under every name it has (a unit's battle_1 and battle_2 are often the same file).
const pictures = [...Map.groupBy(entity.pictures, (p: { file: string }) => p.file).values()].map((same) => ({
	...same[0],
	names: same.map((p: { name: string }) => label(p.name)).join(', '),
}));

const headings = [
	{ depth: 2, slug: 'details', text: 'Details' },
	...(text.length ? [{ depth: 2, slug: 'text', text: 'Text' }] : []),
	...loaded.map((t) => ({ depth: 2, slug: t.id, text: t.label })),
	...(incoming.length ? [{ depth: 2, slug: 'referenced-by', text: 'Referenced by' }] : []),
	...(relations.length ? [{ depth: 2, slug: 'found-in-scripts', text: 'Found in scripts' }] : []),
];
const version = data.manifest.game_version ? `, game version ${data.manifest.game_version}` : '';
---

<StarlightPage
	frontmatter={{ title: entity.title, tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 2 }, prev: false, next: false }}
	sidebar={databaseSidebar(data)}
	headings={headings}
>
	<span data-pagefind-filter={`game:${data.title}`}></span>
	<span data-pagefind-filter={`kind:${kind.label.one}`}></span>
	<p class="ome-entity-line" data-pagefind-ignore>
		<a href={`/${data.game}/${kind.id}/`}>{kind.label.one}</a> {entity.id} of {data.title}, from game data revision
		<code>{data.revision}</code>{version}.
	</p>
	<DatabaseSwitches languages={data.languages} />
	{credited && <LanguageCredit data={data} />}

	{
		pictures.length > 0 && (
			<div class="ome-pictures not-content" data-pagefind-ignore>
				{pictures.map((picture) => (
					<figure>
						<Picture data={data} picture={picture} alt={`${entity.title}: ${picture.names}`} />
						<figcaption>{picture.names}</figcaption>
					</figure>
				))}
			</div>
		)
	}

	<h2 id="details" data-pagefind-ignore>Details</h2>
	<table class="ome-infobox" data-pagefind-ignore>
		<tbody>
			{
				rows.map((row) => (
					<tr>
						<th scope="row">{row.label}</th>
						<td>
							{row.table ? (
								<DataTable variant="nested" columns={row.table.columns} rows={row.table.rows} />
							) : (
								row.items.map((item, i) => (
									<>
										{i > 0 && ', '}
										<Value item={item} />
									</>
								))
							)}
						</td>
					</tr>
				))
			}
		</tbody>
	</table>

	{
		text.length > 0 && (
			<>
				<h2 id="text" data-pagefind-ignore>Text</h2>
				{text.map((t) => (
					<section class="ome-text">
						<h3 data-pagefind-ignore>{t.label}</h3>
						{[[SOURCE_LANGUAGE, t.lines], ...Object.entries(t.translations)].map(([tag, lines]) => (
							<p lang={tag} data-ome-text={Object.keys(t.translations).length ? tag : undefined}>
								{lines.map((line, i) => (
									<>
										{i > 0 && <br />}
										{line}
									</>
								))}
							</p>
						))}
					</section>
				))}
			</>
		)
	}

	{
		loaded.map((t) => (
			<div data-pagefind-ignore>
				<h2 id={t.id}>{t.label}</h2>
				<p>
					What the game's scripts build when it loads this {kind.label.one.toLowerCase()}: {t.rows.length} of the
					table's {t.table.records} records, by record number.
				</p>
				<DataTable variant="wide" columns={t.columns} rows={t.rows} rowHeader="#" />
			</div>
		))
	}

	{
		incoming.length > 0 && (
			<div data-pagefind-ignore>
				<h2 id="referenced-by">Referenced by</h2>
				{incoming.map((group) => (
					<>
						<h3>{group.label}</h3>
						<ul class="ome-links">
							{group.entities.map((e) => (
								<li>
									<a href={e.url}><Name entity={e} /></a>
								</li>
							))}
						</ul>
					</>
				))}
			</div>
		)
	}

	{
		relations.length > 0 && (
			<div data-pagefind-ignore>
				<h2 id="found-in-scripts">Found in scripts</h2>
				<p>
					Found by reading the game's scripts, not shown by the game as data: each script names this
					{' '}{kind.label.one.toLowerCase()} in a call.
					{entity.relations.some((r: { count: number | null }) => r.count !== null) && ' A number in brackets is the count one call sets.'}
				</p>
				<ul>
					{relations.map((group) => (
						<li>
							{group.label}:{' '}
							{group.scripts.map((s, i) => (
								<>
									{i > 0 && ', '}
									{scriptLink(s.script) ? <a href={scriptLink(s.script)}><code>{scriptName(s.script)}</code></a> : <code>{scriptName(s.script)}</code>}
									{calls(s.calls)}
								</>
							))}
						</li>
					))}
				</ul>
			</div>
		)
	}

	<ModderPanel game={data.game} kind={kind} entity={entity} />
	<script is:inline src="/tooltips.js" defer></script>
</StarlightPage>
