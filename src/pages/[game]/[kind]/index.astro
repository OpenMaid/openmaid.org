---
// A kind's list (site design §8.3): every entity in a table, with a filter on each field the export marks filterable
// and on the name. The rows are in the page, so it reads without scripts; a script filters them in the browser and
// keeps the filters in the URL, so a filtered list can be linked. Lists are not in the search index. In modder mode
// (§8.7) the page also lists the scripts that use the kind's table, which each entity's modder panel links to.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Picture from '../../../components/Picture.astro';
import DatabaseSwitches from '../../../components/DatabaseSwitches.astro';
import LanguageCredit from '../../../components/LanguageCredit.astro';
import Name from '../../../components/Name.astro';
import { databaseSidebar, game, games } from '../../../lib/database.mjs';
import { label } from '../../../lib/labels.mjs';
import { referenceGame } from '../../../lib/reference.mjs';
import { href } from '../../../lib/reference-model.mjs';
import { translated } from '../../../lib/values.mjs';

export function getStaticPaths() {
	return games().flatMap((data) => data.kinds.map((kind) => ({ params: { game: data.game, kind: kind.id } })));
}

const data = game(Astro.params.game!);
const kind = data.kinds.find((k) => k.id === Astro.params.kind)!;
const reference = referenceGame(data.game);
const tableLink = (name: string) => (reference.table(name) ? href.table(data.game, name) : null);
const filters = kind.fields
	.filter((field) => field.filter && !field.isArray)
	.map((field) => {
		const counts = new Map<number, number>();
		for (const entity of kind.entities) {
			const value = entity.values[field.name];
			if (value !== null && value !== undefined) counts.set(value, (counts.get(value) ?? 0) + 1);
		}
		return { field, label: label(field.name), values: [...counts].sort((a, b) => a[0] - b[0]) };
	});
---

<StarlightPage
	frontmatter={{ title: `${kind.label.many} of ${data.title}`, pagefind: false, tableOfContents: false, prev: false, next: false }}
	sidebar={databaseSidebar(data)}
>
	<p>
		{kind.entities.length} {kind.label.many.toLowerCase()}, from game data revision <code>{data.revision}</code>. A field
		whose values stand for something in the game (a category, a race) shows them as the game stores them, as numbers.
	</p>
	<DatabaseSwitches languages={data.languages} />
	{translated(kind.entities) && <LanguageCredit data={data} />}
	<form class="ome-filters not-content" data-ome-filters>
		<label>Name <input type="search" name="q" autocomplete="off" /></label>
		{
			filters.map((f) => (
				<label>
					{f.label}
					<select name={f.field.name}>
						<option value="">all</option>
						{f.values.map(([value, count]) => (
							<option value={String(value)}>
								{value} ({count})
							</option>
						))}
					</select>
				</label>
			))
		}
		<output data-ome-count>{kind.entities.length} shown</output>
	</form>
	<table class="ome-list">
		<thead>
			<tr>
				<th></th><th>ID</th><th>Name</th>
				{filters.map((f) => <th>{f.label}</th>)}
			</tr>
		</thead>
		<tbody>
			{
				kind.entities.map((entity) => (
					<tr
						data-name={[...new Set([entity.title, ...Object.values(entity.names)])].join(' ').toLowerCase()}
						{...Object.fromEntries(filters.map((f) => [`data-f-${f.field.name}`, String(entity.values[f.field.name])]))}
					>
						<td class="ome-thumb">
							{entity.thumbnail && <Picture data={data} picture={entity.thumbnail} alt="" />}
						</td>
						<td>{entity.id}</td>
						<td>
							<a href={entity.url}><Name entity={entity} /></a>
						</td>
						{filters.map((f) => <td>{entity.values[f.field.name]}</td>)}
					</tr>
				))
			}
		</tbody>
	</table>
	{
		kind.scriptUse.length > 0 && (
			<section class="ome-modder" aria-labelledby="scripts" data-pagefind-ignore>
				<h2 id="scripts">Scripts that use the table</h2>
				<p>
					Each script of the game whose instructions read, write or index (take as an array's base) a cell of the table{' '}
					<a href={tableLink(kind.table)}><code>{kind.table}</code></a>
					{kind.loaded.length > 0 && <> or of the tables its loaders build ({kind.loaded.map((t, i) => <>{i > 0 && ', '}<a href={tableLink(t.table)}><code>{t.table}</code></a></>)})</>},
					with how many of its operands do each, from OME's script index. A scene that reads a record through an index
					counts as indexing the table.
				</p>
				<table class="ome-cells">
					<thead><tr><th>Script</th><th>Reads</th><th>Writes</th><th>Indexes</th></tr></thead>
					<tbody>
						{kind.scriptUse.map((use) => (
							<tr>
								<td>{reference.script(use.script) ? <a href={href.script(data.game, use.script)}><code>{use.script}</code></a> : <code>{use.script}</code>}</td>
								<td>{use.reads}</td>
								<td>{use.writes}</td>
								<td>{use.addresses}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>
		)
	}
	<script is:inline src="/tooltips.js" defer></script>
</StarlightPage>

<script>
	const form = document.querySelector<HTMLFormElement>('form[data-ome-filters]')!;
	const rows = [...document.querySelectorAll<HTMLTableRowElement>('table.ome-list tbody tr')];
	const count = form.querySelector('output[data-ome-count]')!;
	const params = new URLSearchParams(location.search);
	for (const control of form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select'))
		if (params.has(control.name)) control.value = params.get(control.name)!;

	const apply = () => {
		const wanted = [...new FormData(form)].filter(([, value]) => value !== '') as [string, string][];
		let shown = 0;
		for (const row of rows) {
			const match = wanted.every(([name, value]) =>
				name === 'q' ? row.dataset.name!.includes(value.toLowerCase()) : row.getAttribute(`data-f-${name}`) === value,
			);
			row.hidden = !match;
			if (match) shown++;
		}
		count.textContent = `${shown} shown`;
		const url = new URL(location.href);
		url.search = new URLSearchParams(wanted).toString();
		history.replaceState(null, '', url);
	};
	form.addEventListener('input', apply);
	form.addEventListener('submit', (event) => event.preventDefault());
	apply();
</script>

<style is:global>
	/* A kind's list takes the page's whole width (the user, 2026-11-22): its table has room for more columns. */
	.sl-container {
		max-width: none;
	}
	/* Starlight lays a table out as a block that scrolls, as wide as its content; on a wide screen the list fills the
	   page instead. */
	@media (min-width: 50rem) {
		table.ome-list {
			display: table;
			width: 100%;
		}
	}
	table.ome-list td {
		vertical-align: middle;
	}
</style>
