---
// A kind's list (site design §8.3, site plan §9.1): every entity in a table. The build draws it with the kind's
// default columns (src/lib/columns.mjs), so it reads without scripts; a script (src/scripts/list-table.ts) then draws
// it from the kind's list file with the columns a visitor chooses, sorts it by any column whose heading they press, and
// filters it by the name and by any column they add a filter on, keeping all of it in the URL, so a list can be
// linked. Lists are not in the search index. In
// modder mode (§8.7) the page also lists the scripts that use the kind's table, which each entity's modder panel links
// to.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DatabaseSwitches from '../../../components/DatabaseSwitches.astro';
import LanguageCredit from '../../../components/LanguageCredit.astro';
import Name from '../../../components/Name.astro';
import Value from '../../../components/Value.astro';
import WidePage from '../../../components/WidePage.astro';
import { cellItems, defaultColumns } from '../../../lib/columns.mjs';
import { databaseSidebar, game, games } from '../../../lib/database.mjs';
import { referenceGame } from '../../../lib/reference.mjs';
import { href } from '../../../lib/reference-model.mjs';
import { SOURCE_LANGUAGE } from '../../../lib/language.mjs';
import { translated } from '../../../lib/values.mjs';

export function getStaticPaths() {
	return games().flatMap((data) => data.kinds.map((kind) => ({ params: { game: data.game, kind: kind.id } })));
}

const data = game(Astro.params.game!);
const kind = data.kinds.find((k) => k.id === Astro.params.kind)!;
const reference = referenceGame(data.game);
const tableLink = (name: string) => (reference.table(name) ? href.table(data.game, name) : null);
const shown = defaultColumns(kind);
const pictured = kind.entities.some((entity) => entity.thumbnail);
---

<StarlightPage
	frontmatter={{ title: `${kind.label.many} of ${data.title}`, pagefind: false, tableOfContents: false, prev: false, next: false }}
	sidebar={databaseSidebar(data)}
>
	<p>
		{kind.about && <>{kind.about} </>}{data.title} has {kind.entities.length.toLocaleString('en')}{' '}
		{kind.entities.length === 1 ? kind.label.one.toLowerCase() : kind.label.many.toLowerCase()}.
	</p>
	<DatabaseSwitches languages={data.languages} />
	<form class="ome-filters not-content" data-ome-filters data-lang={data.languages[0] ?? SOURCE_LANGUAGE}>
		<label>Name <input type="search" name="q" autocomplete="off" /></label>
		<span class="ome-added" data-ome-added></span>
		<span class="ome-list-tools" data-ome-tools hidden></span>
		<output data-ome-count>{kind.entities.length.toLocaleString('en')} shown</output>
	</form>
	<div class="ome-list-box">
		<table class="ome-list" data-ome-list={`/${data.game}/${kind.id}/list.json`}>
			<thead>
				<tr>
					<th scope="col" class="ome-num">ID</th>
					<th scope="col">Name</th>
					{
						shown.map((column) => (
							<th scope="col" class:list={{ 'ome-num': column.type === 'number' }}>
								{column.group && <span class="ome-col-group">{column.group}</span>}
								{column.note ? (
									<span class="ome-noted" title={column.note}>
										{typeof column.label === 'string' ? column.label : <Name entity={column.label} />}
									</span>
								) : typeof column.label === 'string' ? (
									column.label
								) : (
									<Name entity={column.label} />
								)}
							</th>
						))
					}
				</tr>
			</thead>
			<tbody>
				{
					kind.entities.map((entity) => (
						<tr>
							<td class="ome-num">{entity.id}</td>
							<td>
								<Value item={{ entity, ...(pictured ? { thumb: entity.thumbnail } : {}) }} data={data} />
							</td>
							{shown.map((column) => (
								<td class:list={{ 'ome-num': column.type === 'number', 'ome-wrap': ['entities', 'list'].includes(column.type) }}>
									{cellItems(column, entity).map((item, i) => (
										<>
											{i > 0 && ', '}
											<Value item={item} />
										</>
									))}
								</td>
							))}
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
	{
		kind.scriptUse.length > 0 && (
			<section class="ome-modder" aria-labelledby="scripts" data-pagefind-ignore>
				<h2 id="scripts">Scripts that use the table</h2>
				<p>
					Each script of the game whose instructions read, write or index (take as an array's base) a cell of the table{' '}
					<a href={tableLink(kind.table)}><code>{kind.table}</code></a>
					{kind.loaded.length > 0 && <> or of the tables its loaders build ({kind.loaded.map((t, i) => <>{i > 0 && ', '}<a href={tableLink(t.table)}><code>{t.table}</code></a></>)})</>},
					with how many of its operands do each, from OME's script index. A scene that reads a record through an index
					counts as indexing the table.
				</p>
				<table class="ome-cells">
					<thead><tr><th>Script</th><th>Reads</th><th>Writes</th><th>Indexes</th></tr></thead>
					<tbody>
						{kind.scriptUse.map((use) => (
							<tr>
								<td>{reference.script(use.script) ? <a href={href.script(data.game, use.script)}><code>{use.script}</code></a> : <code>{use.script}</code>}</td>
								<td>{use.reads}</td>
								<td>{use.writes}</td>
								<td>{use.addresses}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>
		)
	}
	<p class="ome-entity-line ome-page-foot">From {data.title}'s game data revision <code>{data.revision}</code>.</p>
	{translated(kind.entities) && <LanguageCredit data={data} switched />}
	<script is:inline src="/tooltips.js" defer></script>
	<WidePage />
</StarlightPage>

<script>
	import '../../../scripts/list-table.ts';
</script>
